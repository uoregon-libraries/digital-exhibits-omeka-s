# Copy this to .env to change any defaults. For local development, a .env is
# optional: everything below already defaults to these values.

# Database credentials, used by both the Omeka and MariaDB containers
DB_NAME=omeka
DB_USER=omeka
DB_PASS=omeka

# Host port the site is published on
HOST_PORT=8001

# Production only: host directories for compose.prod.yaml
#FILES_LOCATION=/path/to/omeka/files
#SIDELOAD_LOCATION=/path/to/omeka/sideload-files
#DB_LOCATION=/path/to/mysql/data
